rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own document
    match /users/{uid} {
      allow read:   if request.auth != null;          // leaderboard needs to read all users
      allow write:  if request.auth.uid == uid;       // can only edit your own profile
    }

    // Username reservation — anyone authenticated can read, 
    // only the account owner can create (prevents takeover)
    match /usernames/{username} {
      allow read:   if true;
      allow create: if request.auth != null;
      allow update, delete: if false;                 // usernames are permanent
    }
  }
}
